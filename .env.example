VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Stripe publishable key (safe to expose client-side — this is NOT the
# secret key). Used to mount the embedded card fields on the Payment page.
# The secret key lives only in Supabase Edge Function secrets, never here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
